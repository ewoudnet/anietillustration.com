# Kopieer dit bestand naar .env en vul de echte waarden in.
# Het .env bestand zelf mag NOOIT in git/GitHub of publiek toegankelijk terechtkomen.

# URL van de publieke specials/-site (niet van backend/) - hier komen Mollie-redirects/webhooks
# op terug, en backend/ gebruikt dit om banner-afbeeldingen te tonen die fysiek in specials/
# staan (zie backend/bootstrap.php). Moet de omgeving matchen waar dit draait (lokaal :8002,
# live de echte submap-URL) - anders werken Mollie-redirects/webhooks niet.
APP_URL=http://localhost:8002

# Live/publieke specials-URL zoals klanten hem zien - gebruikt door backend/ voor "bekijk
# live"-links (form.php), losstaand van APP_URL zodat die links nooit naar localhost wijzen
# terwijl je lokaal test.
PUBLIC_URL=https://aniet.nl/specials

# Database
DB_HOST=localhost
DB_NAME=anietillustration
DB_USER=root
DB_PASS=

# Mollie (haal je live/test API key op uit je Mollie dashboard)
MOLLIE_API_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SMTP voor de bevestigingsmail
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=info@anietillustration.com
MAIL_FROM_NAME="Aniet Illustration"
